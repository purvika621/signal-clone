worker_processes 1;
pid /tmp/signal-nginx.pid;
error_log /dev/stderr warn;
events { worker_connections 1024; }
http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    # Do not log socket query strings, cookies or message bodies.
    log_format safe '$request_method $uri $status';
    access_log /dev/stdout safe;
    map $http_upgrade $connection_upgrade { default upgrade; '' close; }
    map $http_x_forwarded_proto $forwarded_proto { default $scheme; https https; }
    server {
        listen @PORT@;
        server_name _;
        client_max_body_size 1m;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_set_header Origin $http_origin;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        proxy_buffering off;
        location /api/v1/ { proxy_pass http://127.0.0.1:8000; }
        location = /health { proxy_pass http://127.0.0.1:8000; }
        location = /docs { proxy_pass http://127.0.0.1:8000; }
        location = /openapi.json { proxy_pass http://127.0.0.1:8000; }
        location / { proxy_pass http://127.0.0.1:3000; }
    }
}
