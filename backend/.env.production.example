# Examples only: replace the origin with the actual HTTPS frontend origin.
APP_NAME=Signal Desktop Clone API
# Linux absolute path on a persistent volume; four slashes are intentional.
DATABASE_URL=sqlite:////data/signal.db
FRONTEND_ORIGIN=https://app.example.invalid
WEBSOCKET_ORIGIN=https://app.example.invalid
SESSION_COOKIE_SECURE=true
SESSION_DAYS=7
MOCK_OTP=123456
SQLITE_BUSY_TIMEOUT_MS=5000
# The host must provide PORT; omit this example if it injects the value itself.
PORT=8000
