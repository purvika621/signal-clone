APP_NAME=Signal Desktop Clone API
DATABASE_URL=sqlite:///./data/signal.db
FRONTEND_ORIGIN=http://localhost:3000
# Optional explicit browser Origin for WebSockets; defaults to FRONTEND_ORIGIN.
# WEBSOCKET_ORIGIN=http://localhost:3000
# Production entry point binds 0.0.0.0 and reads the platform PORT.
PORT=8000
SQLITE_BUSY_TIMEOUT_MS=5000
MOCK_OTP=123456
SESSION_DAYS=7
# Set true behind HTTPS when hosting. Keep false for local HTTP development.
SESSION_COOKIE_SECURE=false

