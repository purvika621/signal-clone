{
  "name": "signal-desktop-clone-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname localhost",
    "build": "next build",
    "start": "next start --hostname localhost",
    "start:production": "next start --hostname 0.0.0.0",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "verify:connectivity": "node --env-file=.env.local scripts/check-connectivity.mjs",
    "verify:phase3b": "node --env-file=.env.local scripts/check-phase3b.mjs",
    "verify:messaging-state": "node --env-file=.env.local scripts/check-messaging-state.mjs"
  },
  "dependencies": {
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
